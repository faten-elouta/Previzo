def is_valid_numeric_dashboard_id(value):
    return value is not None and str(value).strip().isdigit()


def validate_dashboards_config():
    issues = []

    for dash_key, dash in DASHBOARDS.items():
        mode = dash.get("mode")
        title = dash.get("title", f"dashboard_{dash_key}")

        if mode in ["embed", "embed_group"]:
            if not dash.get("embedded_dashboard_id"):
                issues.append(f"[{title}] embedded_dashboard_id manquant")
            if not is_valid_numeric_dashboard_id(dash.get("dashboard_numeric_id")):
                issues.append(
                    f"[{title}] dashboard_numeric_id invalide: {dash.get('dashboard_numeric_id')}"
                )

        if mode == "embed_group":
            for tab in dash.get("subtabs", []):
                label = tab.get("label", tab.get("key", "tab"))
                if not tab.get("embedded_dashboard_id"):
                    issues.append(f"[{title} > {label}] embedded_dashboard_id manquant")
                if not is_valid_numeric_dashboard_id(tab.get("dashboard_numeric_id")):
                    issues.append(
                        f"[{title} > {label}] dashboard_numeric_id invalide: {tab.get('dashboard_numeric_id')}"
                    )

    return issues


def superset_login_and_guest_token(dashboard_numeric_id, debug=False):
    dashboard_numeric_id = str(dashboard_numeric_id).strip()

    if not dashboard_numeric_id.isdigit():
        raise RuntimeError(
            f"dashboard_numeric_id invalide pour guest token: {dashboard_numeric_id}"
        )

    with httpx.Client(timeout=20.0, follow_redirects=True) as client:
        login_payload = {
            "username": SUPERSET_USER,
            "password": SUPERSET_PASSWORD,
            "provider": "db",
            "refresh": True,
        }

        login_resp = client.post(
            f"{SUPERSET_API_URL}/api/v1/security/login",
            json=login_payload,
            headers={"Content-Type": "application/json"},
        )

        if debug:
            print("\n=== LOGIN SUPERSET ===")
            print("STATUS:", login_resp.status_code)
            print("BODY:", login_resp.text)

        login_resp.raise_for_status()
        login_json = login_resp.json()
        access_token = login_json.get("access_token")
        if not access_token:
            raise RuntimeError(f"Login Superset invalide: {login_json}")

        csrf_resp = client.get(
            f"{SUPERSET_API_URL}/api/v1/security/csrf_token/",
            headers={
                "Authorization": f"Bearer {access_token}",
                "Referer": LOCAL_APP_ORIGIN,
            },
        )
        csrf_resp.raise_for_status()

        csrf_json = csrf_resp.json()
        csrf_token = csrf_json.get("result")
        if not csrf_token:
            raise RuntimeError(f"Réponse CSRF invalide: {csrf_json}")

        guest_payload = {
            "resources": [{"type": "dashboard", "id": dashboard_numeric_id}],
            "rls": [],
            "user": {
                "username": "embedded-user",
                "first_name": "Embedded",
                "last_name": "User",
            },
        }

        guest_resp = client.post(
            f"{SUPERSET_API_URL}/api/v1/security/guest_token/",
            json=guest_payload,
            headers={
                "Authorization": f"Bearer {access_token}",
                "X-CSRFToken": csrf_token,
                "Referer": LOCAL_APP_ORIGIN,
                "Content-Type": "application/json",
            },
        )

        if debug:
            print("\n=== GUEST TOKEN ===")
            print("STATUS:", guest_resp.status_code)
            print("BODY:", guest_resp.text)
            print("PAYLOAD:", json.dumps(guest_payload, ensure_ascii=False, indent=2))

        guest_resp.raise_for_status()

        guest_json = guest_resp.json()
        token = guest_json.get("token")
        if not token:
            raise RuntimeError(f"Réponse guest token invalide: {guest_json}")

        return token


