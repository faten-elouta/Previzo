            --primary-strong: #084298;
            --primary-soft: #eaf2ff;

            --accent: #f59e0b;
            --success: #16a34a;
            --danger: #dc2626;

            --shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
            --shadow-soft: 0 6px 14px rgba(15, 23, 42, 0.05);
            --shadow-left: 0 14px 30px rgba(11, 94, 215, 0.09);

            --radius: 14px;
            --sidebar-width: 250px;
            --page-padding: 10px;
        }

        * { box-sizing: border-box; }

        html, body {
            margin: 0;
            height: 100%;
        }

        body {
            font-family: Inter, Arial, sans-serif;
            color: var(--text);
            background:
                radial-gradient(circle at top left, #eef5ff 0%, transparent 24%),
                radial-gradient(circle at bottom right, #effaf5 0%, transparent 18%),
                var(--bg);
        }

        .layout {
            min-height: 100vh;
            display: grid;
            grid-template-columns: var(--sidebar-width) 1fr;
        }

        .sidebar {
            position: sticky;
            top: 0;
            height: 100vh;
            overflow: hidden;
            padding: 8px;
            border-right: 1px solid var(--line);
            background: linear-gradient(180deg, rgba(255,255,255,0.96) 0%, rgba(246,250,255,0.98) 100%);
            backdrop-filter: blur(12px);
        }

        .sidebar-inner {
            height: calc(100vh - 16px);
            display: grid;
            grid-template-rows: auto auto 1fr auto;
            gap: 8px;
            overflow: hidden;
        }

        .card {
            background: var(--panel);
            border: 1px solid rgba(223, 232, 242, 0.95);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            backdrop-filter: blur(10px);
        }

        .brand-card {
            padding: 8px;
        }

        .brand-logo {
            width: 100%;
            height: 62px;
            border-radius: 10px;
            border: 1px solid var(--line);
            background: linear-gradient(135deg, #eef5ff 0%, #ffffff 100%);
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .brand-logo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            background: #fff;
        }

        .brand-fallback {
            font-size: 18px;
            font-weight: 900;
            color: var(--primary);
        }

        .mini-overview {
            position: relative;
            padding: 10px;
            overflow: hidden;
            background: linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(244,249,255,0.98) 100%);
            box-shadow: var(--shadow-left);
        }

        .mini-overview::before {
            content: "";
            position: absolute;
            inset: 0 0 auto 0;
            height: 4px;
            background: linear-gradient(90deg, var(--primary) 0%, #38bdf8 55%, #22c55e 100%);
        }

        .mini-overview::after {
            content: "";
            position: absolute;
            width: 130px;
            height: 130px;
            top: -45px;
            right: -45px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(11,94,215,0.09) 0%, rgba(11,94,215,0) 70%);
            pointer-events: none;
        }

        .mini-title {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 8px;
            margin-bottom: 8px;
        }

        .mini-title-group {
            display: flex;
            flex-direction: column;
            gap: 2px;
            min-width: 0;
        }

        .mini-title-text {
            font-size: 13px;
            font-weight: 900;
            line-height: 1.2;
            color: var(--text);
        }

        .mini-subtitle {
            font-size: 10px;
            color: var(--muted);
            font-weight: 700;
            line-height: 1.2;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 4px 8px;
            border-radius: 999px;
            color: #fff;
            font-size: 10px;
            font-weight: 900;
            white-space: nowrap;
            box-shadow: 0 6px 12px rgba(0,0,0,0.08);
        }

        .mini-legend {
            display: flex;
            gap: 4px;
            flex-wrap: wrap;
            margin-bottom: 8px;
        }

        .mini-legend-item {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 9px;
            font-weight: 800;
            color: var(--text-soft);
            background: rgba(255,255,255,0.95);
            border: 1px solid var(--line);
            border-radius: 999px;
            padding: 4px 6px;
        }

        .mini-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            display: inline-block;
        }

        .basin-indicator {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 8px 9px;
            margin-bottom: 8px;
            border-radius: 10px;
            border: 1px solid #d9e6f8;
            background: linear-gradient(135deg, #eef5ff 0%, #ffffff 100%);
        }

        .basin-left {
            display: flex;
            flex-direction: column;
            gap: 1px;
            min-width: 0;
        }

        .basin-label {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: var(--muted);
            font-weight: 900;
        }

        .basin-value {
            font-size: 13px;
            font-weight: 900;
            color: var(--primary-strong);
            line-height: 1.1;
        }

        .basin-badge {
            padding: 4px 7px;
            border-radius: 999px;
            background: var(--primary);
            color: #fff;
            font-size: 9px;
            font-weight: 900;
            box-shadow: 0 6px 12px rgba(11, 94, 215, 0.18);
        }

        #sensor-map {
            width: 100%;
            height: 100px;
            border-radius: 10px;
            overflow: hidden;
            border: 1px solid var(--line);
            margin-bottom: 8px;
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.8);
        }

        .mini-kpis {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4px;
        }

        .mini-kpi {
            padding: 5px 6px;
            border-radius: 9px;
            background: #ffffff;
            border: 1px solid #e5edf6;
            box-shadow: var(--shadow-soft);
            display: flex;
            flex-direction: column;
            gap: 1px;
        }

        .mini-kpi-label {
            font-size: 8px;
            font-weight: 700;
            color: var(--muted);
        }

        .mini-kpi-value {
            font-size: 12px;
            font-weight: 900;
            line-height: 1;
        }

        .nav-card {
            padding: 10px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            min-height: 0;
        }

        .nav-title {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: var(--muted);
            font-weight: 900;
            margin-bottom: 8px;
            flex-shrink: 0;
        }

        .dashboard-list {
            display: grid;
            gap: 6px;
        }

        .sidebar-scroll {
            overflow-y: auto;
            min-height: 0;
            padding-right: 2px;
        }

        .sidebar-scroll::-webkit-scrollbar {
            width: 6px;
        }

        .sidebar-scroll::-webkit-scrollbar-thumb {
            background: #c9d8ee;
            border-radius: 999px;
        }

        .item {
            display: block;
            text-decoration: none;
            color: inherit;
            padding: 8px 9px;
            border-radius: 11px;
            background: var(--panel-solid);
            border: 1px solid var(--line);
            box-shadow: var(--shadow-soft);
            transition: transform .16s ease, border-color .16s ease, background .16s ease, box-shadow .16s ease;
        }

        .item:hover {
            transform: translateY(-1px);
            border-color: #8fb4f3;
            box-shadow: 0 8px 18px rgba(15, 23, 42, 0.07);
        }

        .item.active {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-strong) 100%);
            border-color: var(--primary-strong);
            color: #ffffff;
            box-shadow: 0 10px 20px rgba(11, 94, 215, 0.22);
        }

        .item.active .item-title,
        .item.active .item-subtitle {
            color: #ffffff;
        }

        .item-title {
            font-size: 11px;
            font-weight: 900;
            line-height: 1.2;
        }

        .item-subtitle {
            margin-top: 2px;
            font-size: 12px;
            color: var(--text-soft);
            font-weight: 800;
            line-height: 1.25;
        }

        .only-subtitle {
            margin-top: 0;
            font-size: 13px;
            font-weight: 900;
            line-height: 1.2;
            color: inherit;
        }

        .bottom-link-card {
            padding: 8px;
            background: linear-gradient(135deg, #f5f8ff 0%, #fdf6ff 100%);
            border: 1px solid #e7e9f8;
        }

        .bottom-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            text-decoration: none;
            color: inherit;
            background: #fff;
            border: 1px solid #e6e8f5;
            border-radius: 10px;
            padding: 8px 10px;
            box-shadow: var(--shadow-soft);
            transition: transform .16s ease, box-shadow .16s ease;
        }

        .bottom-link:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 18px rgba(15, 23, 42, 0.07);
        }

        .bottom-link-left {
            display: flex;
            flex-direction: column;
            gap: 1px;
        }

        .bottom-link-kicker {
            font-size: 8px;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: #7c3aed;
            font-weight: 900;
        }

        .bottom-link-title {
            font-size: 11px;
            font-weight: 900;
            color: var(--text);
        }

        .bottom-link-badge {
            min-width: 26px;
            height: 26px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: linear-gradient(135deg, #8b5cf6 0%, #6366f1 100%);
            color: #fff;
            font-weight: 900;
            font-size: 11px;
        }

        .main {
            min-height: 100vh;
            padding: var(--page-padding);
            overflow: visible;
        }

        .main-inner {
            display: grid;
            gap: 10px;
        }

        .viewer-card {
            overflow: visible;
        }

        .embed-head {
            position: sticky;
            top: 10px;
            z-index: 40;
            display: flex;
            flex-direction: column;
            gap: 10px;
            padding: 16px 16px 12px;
            border-bottom: 1px solid var(--line);
            background: rgba(255,255,255,0.97);
            backdrop-filter: blur(12px);
            border-top-left-radius: var(--radius);
            border-top-right-radius: var(--radius);
        }

        .embed-kicker {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: var(--primary);
            font-weight: 900;
            margin-bottom: 4px;
        }

        .embed-title {
            font-size: 26px;
            font-weight: 900;
            line-height: 1.1;
            color: #102947;
            margin: 0;
        }

        .subtabs {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            align-items: center;
            justify-content: flex-end;
            width: 100%;
        }

        .subtab-btn {
            appearance: none;
            border: 1px solid #c9d8ee;
            background: #ffffff;
            color: var(--text-soft);
            border-radius: 999px;
            padding: 6px 11px;
            font-size: 10px;
            font-weight: 800;
            cursor: pointer;
            transition: all .16s ease;
            box-shadow: var(--shadow-soft);
        }

        .subtab-btn:hover {
            transform: translateY(-1px);
            border-color: #8fb4f3;
            color: var(--primary-strong);
            background: var(--primary-soft);
        }

        .subtab-btn.active {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-strong) 100%);
            color: #fff;
            border-color: var(--primary-strong);
            box-shadow: 0 8px 18px rgba(11, 94, 215, 0.22);
        }

        .embed-status {
            padding: 8px 14px;
            background: #f8fbff;
            color: #27486e;
            border-bottom: 1px solid var(--line);
            font-size: 11px;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .embed-status.error,
        .error {
            color: #a61b1b;
            background: #fff2f2;
            border-color: #f3c9c9;
        }

        #embedded-dashboard {
            width: 100%;
            min-height: 820px;
            background: #fff;
        }

        iframe {
            display: block;
            width: 100%;
            min-height: 820px;
            border: none;
            background: #fff;
        }

        .content-card {
            padding: 18px;
            overflow: auto;
        }

        .empty {
            min-height: 420px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: var(--muted);
            background: rgba(255,255,255,0.75);
            border: 1px dashed #cdd8e6;
            border-radius: 20px;
            font-size: 20px;
            font-weight: 800;
        }

        .empty.dashboard-empty {
            min-height: 78vh;
            flex-direction: column;
            gap: 10px;
        }

        .empty.dashboard-empty .empty-title {
            font-size: 28px;
            font-weight: 900;
            color: #1b3555;
        }

        .empty.dashboard-empty .empty-subtitle {
            font-size: 15px;
            color: var(--muted);
            max-width: 520px;
            line-height: 1.5;
        }

        .error {
            padding: 14px;
            border-radius: 14px;
            border: 1px solid #f3c9c9;
        }

        .report-iframe {
            width: 100%;
            min-height: 680px;
            border: 1px solid var(--line);
            border-radius: 16px;
            background: #fff;
            margin-top: 14px;
        }

        .meta {
            margin-bottom: 16px;
            color: var(--muted);
            font-size: 14px;
        }

        .section-title {
            margin: 20px 0 12px;
            font-size: 18px;
            font-weight: 900;
            color: var(--text);
        }

        .report-block {
            margin-top: 24px;
            padding-top: 18px;
            border-top: 1px solid #edf2f7;
        }

        .report-block h3 {
            margin: 0 0 10px;
            font-size: 21px;
            color: var(--text);
        }

        .report-block p,
        .content-card p {
            line-height: 1.65;
            color: #31465b;
            font-size: 15px;
        }

        pre {
            background: #f7f9fc;
            padding: 16px;
            border-radius: 14px;
            overflow: auto;
            white-space: pre-wrap;
            word-break: break-word;
            border: 1px solid var(--line);
        }

        .leaflet-container {
            font: inherit;
        }

        .custom-div-icon {
            background: transparent;
            border: none;
        }

        .marker-wrap {
            width: 12px;
            height: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .marker-symbol {
            width: 12px;
            height: 12px;
            display: block;
            filter: drop-shadow(0 1px 3px rgba(0,0,0,0.18));
        }

        .leaflet-popup-content-wrapper {
            border-radius: 12px;
        }

        @media (max-width: 1180px) {
            :root {
                --sidebar-width: 230px;
            }

            .embed-title {
                font-size: 23px;
            }
        }

        @media (max-width: 980px) {
            .layout {
                grid-template-columns: 1fr;
            }

            .sidebar {
                position: relative;
                height: auto;
                overflow: visible;
                min-height: auto;
                border-right: none;
                border-bottom: 1px solid var(--line);
            }

            .sidebar-inner {
                height: auto;
                display: flex;
                flex-direction: column;
                overflow: visible;
            }

            .sidebar-scroll {
                overflow: visible;
            }

            .main {
                min-height: auto;
            }

            .embed-head {
                position: relative;
                top: 0;
            }

            #embedded-dashboard,
            iframe {
                min-height: 680px;
            }

            #sensor-map {
                height: 130px;
            }
        }
    </style>
</head>
<body>
    <div class="layout">
        <aside class="sidebar">
            <div class="sidebar-inner">
                <div class="card brand-card">
                    <div class="brand-logo">
                        {% if logo_url %}
                            <img src="{{ logo_url }}" alt="Logo PrévizO">
                        {% else %}
                            <div class="brand-fallback">PZ</div>
                        {% endif %}
                    </div>
                </div>

                <div class="card mini-overview">
                    <div class="mini-title">
                        <div class="mini-title-group">
                            <div class="mini-title-text">Actualité</div>
                        </div>

                        <span class="status-pill" style="background: {{ station_stats.color }};">
                            {{ station_stats.level }}
                        </span>
                    </div>

                    <div class="mini-legend">
                        <span class="mini-legend-item">
                            <span class="mini-dot" style="background:#2563eb;"></span>Capteurs
                        </span>
                        <span class="mini-legend-item">
                            <span class="mini-dot" style="background:#16a34a;"></span>Piézomètres
                        </span>
                        <span class="mini-legend-item">
                            <span class="mini-dot" style="background:#f59e0b;"></span>Météo
                        </span>
                    </div>

                    <div class="basin-indicator">
                        <div class="basin-left">
                            <span class="basin-label">Bassin</span>
                            <span class="basin-value">Cheraval</span>
                        </div>
                        <span class="basin-badge">Actif</span>
                    </div>

                    <div id="sensor-map"></div>

                    <div class="mini-kpis">
                        <div class="mini-kpi">
                            <span class="mini-kpi-label">Capteurs</span>
                            <span class="mini-kpi-value">{{ station_stats.capteurs }}</span>
                        </div>
                        <div class="mini-kpi">
                            <span class="mini-kpi-label">Piézomètres</span>
                            <span class="mini-kpi-value">{{ station_stats.piezos }}</span>
                        </div>
                        <div class="mini-kpi">
                            <span class="mini-kpi-label">Météo</span>
                            <span class="mini-kpi-value">{{ station_stats.meteo }}</span>
                        </div>
                        <div class="mini-kpi">
                            <span class="mini-kpi-label">Total</span>
                            <span class="mini-kpi-value">{{ station_stats.total }}</span>
                        </div>
                    </div>
                </div>

                {% if mode == 'dashboards' %}
                    <div class="card nav-card">
                        <div class="nav-title">Dashboards</div>
                        <div class="sidebar-scroll">
                            <div class="dashboard-list">
                                {% for dash_id, dash in dashboards.items() %}
                                    <a href="/?mode=dashboards&id={{ dash_id }}"
                                       class="item {% if selected_dashboard_id == dash_id %}active{% endif %}">
                                        <div class="item-subtitle only-subtitle">{{ dash["subtitle"] }}</div>
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="card nav-card">
                        <div class="nav-title">Rapports</div>
                        {% if reports_error %}
                            <div class="error">Erreur de chargement : {{ reports_error }}</div>
                        {% else %}
                            <div class="sidebar-scroll">
                                <div class="dashboard-list">
                                    {% for report in reports %}
                                        <a href="/?mode=reports&report_id={{ report['id'] }}"
                                           class="item {% if selected_report and selected_report['id'] == report['id'] %}active{% endif %}">
                                            <div class="item-title">{{ report["title"] }}</div>
                                        </a>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}

                <div class="card bottom-link-card">
                    {% if mode == 'reports' %}
                        <a class="bottom-link" href="/?mode=dashboards&id=1">
                            <div class="bottom-link-left">
                                <div class="bottom-link-kicker">Navigation opérationnelle</div>
                                <div class="bottom-link-title">Dashboards</div>
                            </div>
                            <div class="bottom-link-badge">→</div>
                        </a>
                    {% else %}
                        <a class="bottom-link" href="/?mode=reports">
                            <div class="bottom-link-left">
                                <div class="bottom-link-kicker">Lecture éditoriale</div>
                                <div class="bottom-link-title">Rapports</div>
                            </div>
                            <div class="bottom-link-badge">→</div>
                        </a>
                    {% endif %}
                </div>
            </div>
        </aside>

        <main class="main">
            <div class="main-inner">
                {% if mode == 'dashboards' %}
                    {% if selected_dashboard %}
                        {% if selected_dashboard.get('mode') in ['embed', 'embed_group'] %}
                            <div class="card viewer-card">
                                <div class="embed-head">
                                    
                                    <div class="embed-title">{{ selected_dashboard["title"] }}</div>

                                    {% if selected_dashboard.get('mode') == 'embed_group' and selected_dashboard.get('subtabs') %}
                                        <div class="subtabs">
                                            {% for tab in selected_dashboard.get('subtabs', []) %}
                                                <button
                                                    type="button"
                                                    class="subtab-btn {% if loop.first %}active{% endif %}"
                                                    data-embedded-id="{{ tab['embedded_dashboard_id'] }}"
                                                    data-dashboard-id="{{ tab['dashboard_numeric_id'] }}"
                                                    data-label="{{ tab['label'] }}"
                                                >
                                                    {{ tab['label'] }}
                                                </button>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>

                                <div id="embed-status" class="embed-status">Chargement…</div>
                                <div id="embedded-dashboard"></div>
                            </div>
                        {% else %}
                            <div class="card viewer-card">
                                <iframe src="{{ selected_dashboard['url'] }}" allowfullscreen loading="lazy"></iframe>
                            </div>
                        {% endif %}
                    {% else %}
                        <div class="empty dashboard-empty">
                            <div class="empty-title">Aucun dashboard sélectionné</div>
                            <div class="empty-subtitle">
                                Cliquez sur un dashboard dans le menu de gauche pour l’afficher.
                            </div>
                        </div>
                    {% endif %}
                {% else %}
                    {% if selected_report %}
                        <div class="card content-card">
                            <div class="meta">ID : {{ selected_report["id"] }}</div>

                            <div class="section-title">Résumé</div>
                            {{ abstract_html|safe }}

                            <div class="section-title">Contenu du rapport</div>
                            {{ content_html|safe }}
                        </div>
                    {% elif reports_error %}
                        <div class="card content-card">
                            <div class="error">Impossible d'afficher les rapports : {{ reports_error }}</div>
                        </div>
                    {% else %}
                        <div class="empty">Choisissez un rapport dans le menu</div>
                    {% endif %}
                {% endif %}
            </div>
        </main>
    </div>

    <script
        src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin="">
    </script>

