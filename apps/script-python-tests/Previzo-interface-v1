def compute_station_stats(dataset):
    capteurs = sum(1 for x in dataset if x["type"] == "capteur")
    piezos = sum(1 for x in dataset if x["type"] == "piezo")
    meteo = sum(1 for x in dataset if x["type"] == "meteo")
    total = len(dataset)

    ratio_total = min(100, round((total / 20) * 100)) if total else 0
    diversity = round((((capteurs > 0) + (piezos > 0) + (meteo > 0)) / 3) * 100)
    situation_score = round((ratio_total * 0.55) + (diversity * 0.45))

    if situation_score < 25:
        level = "Normal"
        color = "#22c55e"
    elif situation_score < 50:
        level = "Vigilance"
        color = "#f59e0b"
    elif situation_score < 75:
        level = "Alerte"
        color = "#f97316"
    else:
        level = "Crise"
        color = "#dc2626"

    return {
        "capteurs": capteurs,
        "piezos": piezos,
        "meteo": meteo,
        "total": total,
        "situation_score": situation_score,
        "level": level,
        "color": color,
    }


STATION_STATS = compute_station_stats(SENSOR_DATASET)

