    <script>
        const sensorData = {{ sensor_points | tojson }};

        function svgIconByType(type) {
            if (type === "capteur") {
                return `
                    <svg class="marker-symbol" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="16" cy="16" r="10" fill="#2563eb" stroke="white" stroke-width="3"/>
                        <circle cx="16" cy="16" r="3" fill="white"/>
                    </svg>
                `;
            }

            if (type === "piezo") {
                return `
                    <svg class="marker-symbol" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
                        <rect x="8" y="6" width="16" height="20" rx="6" fill="#16a34a" stroke="white" stroke-width="3"/>
                        <circle cx="16" cy="16" r="3" fill="white"/>
                    </svg>
                `;
            }

            if (type === "meteo") {
                return `
                    <svg class="marker-symbol" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
                        <polygon points="16,4 27,26 5,26" fill="#f59e0b" stroke="white" stroke-width="3" stroke-linejoin="round"/>
                        <circle cx="16" cy="18" r="2.8" fill="white"/>
                    </svg>
                `;
            }

            return `
                <svg class="marker-symbol" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="16" cy="16" r="10" fill="#64748b" stroke="white" stroke-width="3"/>
                </svg>
            `;
        }

        function iconForType(type) {
            return L.divIcon({
                className: "custom-div-icon",
                html: `<div class="marker-wrap">${svgIconByType(type)}</div>`,
                iconSize: [12, 12],
                iconAnchor: [6, 6],
                popupAnchor: [0, -6]
            });
        }

        function initMap() {
            const mapEl = document.getElementById("sensor-map");
            if (!mapEl) return;

            const map = L.map("sensor-map", {
                zoomControl: true,
                scrollWheelZoom: false,
                dragging: true,
                attributionControl: false
            });

            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                maxZoom: 19
            }).addTo(map);

            const bounds = [];

            sensorData.forEach((p) => {
                if (p.latitude == null || p.longitude == null) return;

                const popupParts = [
                    `<strong>${p.name || "Station"}</strong>`,
                    `<div>Type : ${p.type || "-"}</div>`,
                    `<div>Code : ${p.code || "-"}</div>`
                ];

                if (p.altitude_m != null) {
                    popupParts.push(`<div>Altitude : ${p.altitude_m} m</div>`);
                }

                if (p.url) {
                    popupParts.push(
                        `<div><a href="${p.url}" target="_blank" rel="noopener noreferrer">Voir la fiche</a></div>`
                    );
                }

                L.marker([p.latitude, p.longitude], {
                    icon: iconForType(p.type)
                })
                .addTo(map)
                .bindPopup(popupParts.join(""));

                bounds.push([p.latitude, p.longitude]);
            });

            if (bounds.length > 0) {
                map.fitBounds(bounds, { padding: [16, 16] });
            } else {
                map.setView([47.37, 0.72], 8);
            }

            setTimeout(() => map.invalidateSize(), 250);
            window.addEventListener("resize", () => map.invalidateSize());
        }
    </script>

    {% if mode == 'dashboards' and selected_dashboard and selected_dashboard.get('mode') in ['embed', 'embed_group'] %}
    <script>
        const EMBED_MODE = {{ selected_dashboard.get('mode') | tojson }};
        const SUPERSET_PUBLIC_URL = {{ superset_public_url | tojson }};
        const DEFAULT_EMBEDDED_ID = {{ default_embedded_id | tojson }};
        const DEFAULT_DASHBOARD_NUMERIC_ID = {{ default_dashboard_numeric_id | tojson }};

        async function fetchGuestToken(dashboardNumericId) {
            const response = await fetch(`/api/guest_token?dashboard_id=${encodeURIComponent(dashboardNumericId)}`);
            const data = await response.json();

            if (!response.ok || data.error) {
                throw new Error(data.error || "Impossible de récupérer le guest token");
            }

            return data.token;
        }

        function setStatus(message, isError = false) {
            const statusBox = document.getElementById("embed-status");
            if (!statusBox) return;
            statusBox.style.display = "block";
            statusBox.className = isError ? "embed-status error" : "embed-status";
            statusBox.textContent = message;
        }

        async function mountDashboard(embeddedId, dashboardNumericId, label = "") {
            const mountPoint = document.getElementById("embedded-dashboard");
            if (!mountPoint) return;

            const embedDashboard =
                (window.supersetEmbeddedSdk && window.supersetEmbeddedSdk.embedDashboard) ||
                window.embedDashboard;

            if (!embedDashboard) {
                setStatus("SDK Superset introuvable.", true);
                return;
            }

            const cleanEmbeddedId = String(embeddedId || "").trim();
            const cleanDashboardId = String(dashboardNumericId || "").trim();

            if (!cleanEmbeddedId) {
                setStatus(`Configuration incomplète : embeddedId manquant${label ? " pour " + label : ""}`, true);
                return;
            }

            if (!/^\\d+$/.test(cleanDashboardId)) {
                setStatus(
                    `Configuration invalide : dashboard_numeric_id manquant ou non numérique (${cleanDashboardId || "-"})${label ? " pour " + label : ""}`,
                    true
                );
                return;
            }

            console.log("Mount dashboard:", {
                label,
                embeddedId: cleanEmbeddedId,
                dashboardNumericId: cleanDashboardId
            });

            mountPoint.innerHTML = "";
            setStatus(`Chargement du dashboard${label ? " : " + label : ""}…`, false);

            try {
                const token = await fetchGuestToken(cleanDashboardId);

                await embedDashboard({
                    id: cleanEmbeddedId,
                    supersetDomain: SUPERSET_PUBLIC_URL,
                    mountPoint: mountPoint,
                    fetchGuestToken: async () => token,
                    dashboardUiConfig: {
                        hideTitle: true,
                        hideChartControls: true,
                        hideTab: false,
                        filters: { expanded: false }
                    }
                });

                const statusBox = document.getElementById("embed-status");
                if (statusBox) {
                    statusBox.style.display = "none";
                }
            } catch (error) {
                setStatus(
                    `Erreur embed SDK${label ? " (" + label + ")" : ""} : ${String(error)}`,
                    true
                );
                console.error(error);
            }
        }

        async function initEmbeddedArea() {
            if (!DEFAULT_EMBEDDED_ID || !DEFAULT_DASHBOARD_NUMERIC_ID) {
                setStatus("Configuration dashboard incomplète.", true);
                return;
            }

            await mountDashboard(DEFAULT_EMBEDDED_ID, DEFAULT_DASHBOARD_NUMERIC_ID, "onglet par défaut");

            if (EMBED_MODE === "embed_group") {
                const buttons = document.querySelectorAll(".subtab-btn");

                buttons.forEach((button) => {
                    button.addEventListener("click", async () => {
                        buttons.forEach((btn) => btn.classList.remove("active"));
                        button.classList.add("active");

                        const embeddedId = button.dataset.embeddedId;
                        const dashboardId = button.dataset.dashboardId;
                        const label = button.dataset.label || "";

                        await mountDashboard(embeddedId, dashboardId, label);
                    });
                });
            }
        }
    </script>
    {% endif %}

    <script>
        document.addEventListener("DOMContentLoaded", async function () {
            initMap();

            {% if mode == 'dashboards' and selected_dashboard and selected_dashboard.get('mode') in ['embed', 'embed_group'] %}
            try {
                await initEmbeddedArea();
            } catch (error) {
                const statusBox = document.getElementById("embed-status");
                if (statusBox) {
                    statusBox.style.display = "block";
                    statusBox.className = "embed-status error";
                    statusBox.textContent = "Erreur embed SDK : " + String(error);
                }
                console.error(error);
            }
            {% endif %}
        });
    </script>
</body>
</html>
