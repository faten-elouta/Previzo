def lexical_to_html(value):
    if not value:
        return "<p><em>Aucun contenu</em></p>"

    if isinstance(value, str):
        return f"<p>{escape(value)}</p>"

    root = value.get("root", {})
    children = root.get("children", [])
    html_parts = []

    for node in children:
        if node.get("type") == "paragraph":
            text_parts = []
            for child in node.get("children", []):
                if child.get("type") == "text":
                    text_parts.append(escape(child.get("text", "")))
            paragraph = "".join(text_parts).strip()
            if paragraph:
                html_parts.append(f"<p>{paragraph}</p>")

    return "".join(html_parts) if html_parts else "<p><em>Aucun contenu</em></p>"


def build_superset_chart_url(chart_obj):
    if not chart_obj or not isinstance(chart_obj, dict):
        return None

    chart_id = chart_obj.get("supersetChartId")
    if not chart_id:
        return None

    return f"{SUPERSET_PUBLIC_URL}/superset/explore/?slice_id={chart_id}&standalone=1"


def render_report_blocks(blocks):
    if not blocks or not isinstance(blocks, list):
        return "<p><em>Aucun bloc de contenu</em></p>"

    html_parts = []

    for block in blocks:
        block_type = block.get("blockType")

        if block_type == "report":
            title = escape(block.get("title", ""))
            head_text = escape(block.get("headText", ""))
            chart = block.get("chart")
            chart_url = build_superset_chart_url(chart)

            block_html = ['<section class="report-block">']

            if title:
                block_html.append(f"<h3>{title}</h3>")

            if head_text:
                block_html.append(f"<p>{head_text}</p>")

            if chart_url:
                block_html.append(
                    f'''
                    <iframe
                        class="report-iframe"
                        src="{escape(chart_url, quote=True)}"
                        allowfullscreen
                        loading="lazy">
                    </iframe>
                    '''
                )
            else:
                block_html.append(
                    '<div class="note">Aucun graphique Superset trouvé pour ce bloc.</div>'
                )

            block_html.append("</section>")
            html_parts.append("".join(block_html))
        else:
            html_parts.append(
                f"<pre>{escape(json.dumps(block, ensure_ascii=False, indent=2))}</pre>"
            )

    return "".join(html_parts)


