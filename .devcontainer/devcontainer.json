{
    "name": "previzo-edito-sim",
    "dockerComposeFile": "docker-compose.yml",
    "service": "dev",
    "workspaceFolder": "/workspace",
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
            "version": "latest",
            "enableNonRootDocker": "false",
            "moby": "false"
        }
    },
    "remoteUser": "root",
    "forwardPorts": [
        "cms:3000",
        "database:5432",
        "superset:8088"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-azuretools.vscode-containers"
            ]
        }
    }
}