def to_float(value):
    if value is None:
        return None
    s = str(value).strip()
    if not s:
        return None
    try:
        return float(s.replace(",", "."))
    except ValueError:
        return None


def parse_tsv(tsv_text):
    reader = csv.DictReader(io.StringIO(tsv_text.strip()), delimiter="\t")
    return list(reader)


def build_sensor_dataset():
    dataset = []

    for row in parse_tsv(CAPTEURS_RAW):
        lat = to_float(row.get("latitude"))
        lon = to_float(row.get("longitude"))
        if lat is None or lon is None:
            continue
        dataset.append(
            {
                "type": "capteur",
                "name": row.get("capteur"),
                "code": row.get("eui"),
                "url": None,
                "latitude": lat,
                "longitude": lon,
                "altitude_m": None,
            }
        )

    for row in parse_tsv(PIEZO_RAW):
        lat = to_float(row.get("y"))
        lon = to_float(row.get("x"))
        if lat is None or lon is None:
            continue
        dataset.append(
            {
                "type": "piezo",
                "name": row.get("piezo"),
                "code": row.get("piezo"),
                "url": row.get("urn_bss"),
                "latitude": lat,
                "longitude": lon,
                "altitude_m": None,
            }
        )

    for row in parse_tsv(METEO_RAW):
        lat = to_float(row.get("latitude"))
        lon = to_float(row.get("longitude"))
        if lat is None or lon is None:
            continue

        altitude = row.get("altitude_m")
        altitude_m = None
        if altitude not in (None, ""):
            try:
                altitude_m = int(float(altitude))
            except ValueError:
                altitude_m = None

        dataset.append(
            {
                "type": "meteo",
                "name": row.get("nom_station"),
                "code": row.get("meteo"),
                "url": None,
                "latitude": lat,
                "longitude": lon,
                "altitude_m": altitude_m,
            }
        )

    return dataset


SENSOR_DATASET = build_sensor_dataset()

