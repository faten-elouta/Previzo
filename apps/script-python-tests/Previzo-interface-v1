@app.route("/api/guest_token")
def api_guest_token():
    try:
        dashboard_id = request.args.get("dashboard_id")
        if not dashboard_id:
            return jsonify({"error": "dashboard_id manquant"}), 400

        dashboard_id = str(dashboard_id).strip()
        if not dashboard_id:
            return jsonify({"error": "dashboard_id vide"}), 400

        if not dashboard_id.isdigit():
            return jsonify({"error": f"dashboard_id invalide: {dashboard_id}"}), 400

        token = superset_login_and_guest_token(dashboard_id, debug=True)
        return jsonify({"token": token})

    except Exception as exc:
        return jsonify({"error": str(exc)}), 500


