def get_cms_headers():
    return {
        "Accept": "application/json",
        "Authorization": f"apps API-Key {API_KEY}",
    }


def fetch_reports():
    try:
        with httpx.Client(timeout=10.0) as client:
            response = client.get(CMS_REPORTS_ENDPOINT, headers=get_cms_headers())
            response.raise_for_status()
            data = response.json()

        docs = data.get("docs", [])
        reports = []

        for doc in docs:
            reports.append(
                {
                    "id": doc.get("id"),
                    "title": doc.get("title", "Sans titre"),
                    "abstract": doc.get("abstract"),
                    "content": doc.get("content"),
                    "raw": doc,
                }
            )

        return reports, None

    except Exception as exc:
        return [], str(exc)


def fetch_report_by_id(report_id):
    try:
        with httpx.Client(timeout=10.0) as client:
            response = client.get(
                f"{CMS_REPORTS_ENDPOINT}/{report_id}",
